# An allowlist: everything is ignored unless named here.
/*
!/.gitignore
!/Cargo.toml
!/Cargo.lock
!/README.md
!/LICENSE
!/build-dist.sh

!/src/
/src/**
!/src/*.rs

!/assets/
/assets/**
!/assets/*.ttf
!/assets/*.txt
!/assets/*.svg
# The app icon: a blur the SVG renderer cannot draw.
!/assets/maia.png
# The tour's films: built into the binary, made by tools/tour-media.sh.
!/assets/tour/
!/assets/tour/*.webp

!/tools/
/tools/**
!/tools/sim.sh
!/tools/window.sh
!/tools/lucide_subset.py
!/tools/notices.py
!/tools/tour-media.sh
!/tools/package.sh

# What the packages install besides the program.
!/packaging/
/packaging/**
!/packaging/*.desktop
!/packaging/*.metainfo.xml

# The workflows, by name.
!/.github/
/.github/**
!/.github/workflows/
/.github/workflows/**
!/.github/workflows/release.yml
!/.github/workflows/ci.yml

# The README screenshot, allowed by name once it exists.
!/docs/
/docs/**
!/docs/maia.webp
